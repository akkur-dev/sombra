<UserControl x:Class="Sombra.Wpf.Views.ViewEditPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrl="clr-namespace:Sombra.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">

    <Grid Margin="{StaticResource EditPanelMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock  Style="{StaticResource HeaderTextBlockStyle}" 
                        Margin="{StaticResource HeaderTextBlockMargin}"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"  
                        VerticalAlignment="Center">

                <Button Style="{StaticResource ViewModeIconButtonStyle}" 
                        Content="&#xE70F;" 
                        Command="{Binding EditCommand}" 
                        ToolTip="Редактировать"/>

                <Button Style="{StaticResource ViewModeIconButtonStyle}" 
                        Content="&#xE74D;" 
                        Command="{Binding DeleteCommand}" 
                        ToolTip="Удалить"/>

                <Button Style="{StaticResource EditModeIconButtonStyle}" 
                        Content="&#xE74E;" 
                        Command="{Binding SaveCommand}" 
                        ToolTip="Сохранить"/>

                <Button Style="{StaticResource EditModeIconButtonStyle}" 
                        Content="&#xE711;" 
                        Command="{Binding CancelCommand}" 
                        ToolTip="Отмена"/> 
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctrl:OptionalTextBox Grid.Row="0" 
                                  Text="{Binding Credentials.ResourceUrl}" 
                                  IsReadOnly="True"
                                  Header="URL" 
                                  Style="{StaticResource SingleLineOptionalTextBox}"/>

            <ctrl:OptionalTextBox Grid.Row="1" 
                                  Text="{Binding Credentials.Login}" 
                                  IsReadOnly="True"
                                  Header="Логин" 
                                  Style="{StaticResource SingleLineOptionalTextBox}"/>

            <ctrl:OptionalTextBox Grid.Row="2" 
                                  Text="{Binding Credentials.Password}" 
                                  IsReadOnly="True"
                                  Header="Пароль" 
                                  Style="{StaticResource SingleLineOptionalTextBox}"/>

            <ctrl:OptionalTextBox Grid.Row="3" 
                                  Text="{Binding Credentials.Notes}" 
                                  Header="Дополнительно" 
                                  IsReadOnly="True"
                                  AcceptsReturn="True" 
                                  Height="Auto" 
                                  MinHeight="200" 
                                  VerticalAlignment="Stretch"
                                  Style="{StaticResource MultiLineOptionalTextBox}"/>
        </Grid>

    </Grid>
</UserControl>
