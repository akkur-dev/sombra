<UserControl x:Class="Sombra.Wpf.Views.ViewEditPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">

    <Grid Margin="{StaticResource EditPanelMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock  Style="{StaticResource HeaderTextBlockStyle}" 
                        Margin="{StaticResource HeaderTextBlockMargin}"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"  
                        VerticalAlignment="Center">

                <Button Style="{StaticResource ViewModeIconButtonStyle}" 
                        Content="&#xE70F;" 
                        Command="{Binding EditCommand}" 
                        ToolTip="Редактировать"/>

                <Button Style="{StaticResource ViewModeIconButtonStyle}" 
                        Content="&#xE74D;" 
                        Command="{Binding DeleteCommand}" 
                        ToolTip="Удалить"/>

                <Button Style="{StaticResource EditModeIconButtonStyle}" 
                        Content="&#xE74E;" 
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding Credentials.IsValid}"
                        ToolTip="Сохранить"/>

                <Button Style="{StaticResource EditModeIconButtonStyle}" 
                        Content="&#xE711;" 
                        Command="{Binding CancelCommand}" 
                        ToolTip="Отмена"/> 
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <HeaderedContentControl Grid.Row="0" Header="URL" Template="{StaticResource SingleLineHeaderedControlTemplate}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Style="{StaticResource HeaderedTextBoxStyle}"
                             Height="Auto"
                             Text="{Binding Credentials.ResourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button  Grid.Column="1" 
                             HorizontalAlignment="Right"                              
                             Style="{StaticResource ViewModeIconButtonStyle}" 
                             Content="&#xE8C8;"
                             Command="{Binding CopyCommand}"
                             CommandParameter="{Binding Credentials.ResourceUrl}"/>
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Header="Логин" Template="{StaticResource SingleLineHeaderedControlTemplate}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Style="{StaticResource HeaderedTextBoxStyle}"
                             Height="Auto"
                             Text="{Binding Credentials.Login, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button  Grid.Column="1" 
                             HorizontalAlignment="Right" 
                             Style="{StaticResource ViewModeIconButtonStyle}" 
                             Content="&#xE8C8;"
                             Command="{Binding CopyCommand}"
                             CommandParameter="{Binding Credentials.Login}"/>
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="2" Header="Пароль" Template="{StaticResource SingleLineHeaderedControlTemplate}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Style="{StaticResource HeaderedTextBoxStyle}"
                             Height="Auto"
                             Text="{Binding Credentials.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button  Grid.Column="1" 
                             HorizontalAlignment="Right" 
                             Style="{StaticResource ViewModeIconButtonStyle}" 
                             Content="&#xE8C8;"
                             Command="{Binding CopyCommand}"
                             CommandParameter="{Binding Credentials.Password}"/>
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="3" Header="Дополнительная информация" Template="{StaticResource MultiLineHeaderedControlTemplate}">
                <TextBox Grid.Column="0" 
                         Style="{StaticResource HeaderedMultiLineTextBoxStyle}"
                         Margin="0"
                         Padding="0"
                         Text="{Binding Credentials.Notes, Mode=TwoWay}"/>
            </HeaderedContentControl>

        </Grid>

    </Grid>
</UserControl>
