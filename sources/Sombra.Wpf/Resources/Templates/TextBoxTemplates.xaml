<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Шаблон иконки-->
    <DataTemplate x:Key="IconTemplate">
        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" 
                   FontFamily="Segoe MDL2 Assets" 
                   Foreground="{StaticResource BaseForeBrush}">

            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!--Шаблон плейсхолдера-->
    <DataTemplate x:Key="PlaceholderTemplate">
        <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=TextBox}}" 
                   Foreground="{StaticResource PlaceholderForeBrush}">

            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!--Шаблон иконка + текст-->
    <ControlTemplate x:Key="IconTextTemplate" TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                CornerRadius="{StaticResource TextBoxCornerRadius}">

            <Grid Background="Transparent">
                <ContentPresenter ContentTemplate="{StaticResource IconTemplate}" 
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center" 
                                  Margin="{StaticResource TextBoxPadding}" 
                                  IsHitTestVisible="False"/>

                <ScrollViewer x:Name="PART_ContentHost" 
                              Padding="{TemplateBinding Padding}" 
                              VerticalAlignment="Center" 
                              Focusable="False" 
                              Cursor="IBeam"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--Шаблон плейсхолдер + текст-->
    <ControlTemplate x:Key="PlaceholderTextTemplate" TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                CornerRadius="{StaticResource TextBoxCornerRadius}">

            <Grid Background="Transparent">
                <ScrollViewer x:Name="PART_ContentHost" 
                              Padding="{TemplateBinding Padding}" 
                              VerticalAlignment="Center" 
                              Focusable="False" 
                              Cursor="IBeam"/>

                <ContentPresenter ContentTemplate="{StaticResource PlaceholderTemplate}" 
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center" 
                                  Margin="{TemplateBinding Padding}" 
                                  IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--Шаблон иконка + плейсхолдер + текст-->
    <ControlTemplate x:Key="IconPlaceholderTextTemplate" TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                CornerRadius="{StaticResource TextBoxCornerRadius}">

            <Grid Background="Transparent">
                <ContentPresenter ContentTemplate="{StaticResource IconTemplate}" 
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center" 
                                  Margin="{StaticResource TextBoxPadding}" 
                                  IsHitTestVisible="False"/>

                <ScrollViewer x:Name="PART_ContentHost" 
                              Padding="{TemplateBinding Padding}" 
                              VerticalAlignment="Center" 
                              Focusable="False" 
                              Cursor="IBeam"/>

                <ContentPresenter ContentTemplate="{StaticResource PlaceholderTemplate}" 
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center" 
                                  Margin="{TemplateBinding Padding}" 
                                  IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
