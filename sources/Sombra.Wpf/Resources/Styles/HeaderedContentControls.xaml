<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="SingleLineHeaderedControlTemplate" TargetType="HeaderedContentControl">
        <Border BorderBrush="{StaticResource SelectionBackBrush}" 
                BorderThickness="1" 
                CornerRadius="{StaticResource TextBoxCornerRadius}" 
                Margin="{StaticResource HeaderedControlMargin}"
                Padding="0">

            <Grid Margin="{StaticResource HeaderedControlPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0" 
                                  ContentSource="Header" 
                                  VerticalAlignment="Top"
                                  Margin="{StaticResource HeaderedControlMargin}"/>

                <ContentPresenter Grid.Column="1" 
                                  ContentSource="Content"
                                  VerticalAlignment="Top"
                                  Margin="{StaticResource HeaderedControlMargin}"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="MultiLineHeaderedControlTemplate" TargetType="HeaderedContentControl">
        <Border BorderBrush="{StaticResource SelectionBackBrush}" 
                BorderThickness="1" 
                CornerRadius="{StaticResource TextBoxCornerRadius}" 
                Margin="{StaticResource HeaderedControlMargin}"
                Padding="0">

            <Grid Margin="{StaticResource HeaderedControlPadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentPresenter Grid.Row="0" 
                                  ContentSource="Header" 
                                  VerticalAlignment="Top"
                                  Margin="{StaticResource HeaderedControlMargin}"/>

                <ContentPresenter Grid.Row="1" 
                                  ContentSource="Content"
                                  VerticalAlignment="Top"
                                  Margin="{StaticResource HeaderedControlMargin}"/>
            </Grid>
        </Border>
    </ControlTemplate>

</ResourceDictionary>