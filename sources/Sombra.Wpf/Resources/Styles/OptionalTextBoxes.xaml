<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Sombra.Wpf.Controls">

    <!-- Стиль заголовка -->
    <Style x:Key="OptionalTextBoxHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource BaseForeBrush}"/>
    </Style>

    <!-- Стиль внутреннего поля ввода -->
    <Style x:Key="OptionalInnerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="{StaticResource OptionalTextBoxPadding}"/>
    </Style>

    <!-- Стиль панели кнопок -->
    <Style x:Key="OptionalButtonsItemsControlStyle" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Шаблон однострочного опционального поля ввода-->
    <ControlTemplate x:Key="OptionalSingleTextBoxTemplate" TargetType="{x:Type ctrl:OptionalTextBox}">
        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                CornerRadius="{StaticResource TextBoxCornerRadius}" 
                UseLayoutRounding="True"
                Padding="0">

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{TemplateBinding Header}" 
                           Style="{StaticResource OptionalTextBoxHeaderStyle}"
                           Padding="{StaticResource TextBoxPadding}"/>

                <TextBox Grid.Column="1" 
                         x:Name="PART_TextBox"
                         Text="{TemplateBinding Text}"
                         Style="{StaticResource OptionalInnerTextBoxStyle}"
                         VerticalContentAlignment="Center"/>

                <ItemsControl Grid.Column="2" 
                              ItemsSource="{TemplateBinding OptionButtons}"
                              Style="{StaticResource OptionalButtonsItemsControlStyle}"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--Шаблон многострочного опционального поля ввода-->
    <ControlTemplate x:Key="OptionalMultiTextBoxTemplate" TargetType="{x:Type ctrl:OptionalTextBox}">
        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                CornerRadius="{StaticResource TextBoxCornerRadius}" 
                UseLayoutRounding="True"
                Padding="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{StaticResource TextBoxMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{TemplateBinding Header}" 
                               Style="{StaticResource OptionalTextBoxHeaderStyle}"
                               Padding="{StaticResource OptionalTextBoxPadding}"/>

                    <ItemsControl Grid.Column="1" 
                                  ItemsSource="{TemplateBinding OptionButtons}"
                                  Style="{StaticResource OptionalButtonsItemsControlStyle}"/>
                </Grid>

                <TextBox Grid.Row="1" x:Name="PART_TextBox"
                         Text="{TemplateBinding Text}"
                         AcceptsReturn="{TemplateBinding AcceptsReturn}"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource OptionalInnerTextBoxStyle}"
                         VerticalAlignment="Stretch"
                         Height="Auto"
                         VerticalContentAlignment="Top"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--Глобальный стиль по умолчанию-->
    <Style TargetType="{x:Type ctrl:OptionalTextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource HighlightBackBrush}"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="{StaticResource OptionalTextBoxMargin}"/>
        <Setter Property="Padding" Value="{StaticResource TextBoxPadding}"/>
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!--Глобальный стиль однострочного OptionalTextBox-->
    <Style x:Key="SingleLineOptionalTextBox" TargetType="{x:Type ctrl:OptionalTextBox}" BasedOn="{StaticResource {x:Type ctrl:OptionalTextBox}}">
        <Setter Property="Template" Value="{StaticResource OptionalSingleTextBoxTemplate}"/>
        <Setter Property="MinHeight" Value="35"/>
    </Style>

    <!--Глобальный стиль многострочного OptionalTextBox-->
    <Style x:Key="MultiLineOptionalTextBox" TargetType="{x:Type ctrl:OptionalTextBox}" BasedOn="{StaticResource {x:Type ctrl:OptionalTextBox}}">
        <Setter Property="Template" Value="{StaticResource OptionalMultiTextBoxTemplate}"/>
    </Style>

</ResourceDictionary>
