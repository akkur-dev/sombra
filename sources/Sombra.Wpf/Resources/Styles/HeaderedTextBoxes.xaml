<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:Sombra.Wpf.Controls">

    <Style TargetType="{x:Type ctrl:HeaderedTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:HeaderedTextBox}">
                    <Border Background="Transparent" 
                            BorderBrush="{StaticResource BaseBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="{StaticResource TextBoxCornerRadius}" 
                            Padding="{StaticResource TextBoxPadding}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ctrl:MultiButtonHeader Grid.Row="0"
                                                    Header="{TemplateBinding Header}"
                                                    ItemsSource="{TemplateBinding HeaderButtons}"
                                                    Margin="{StaticResource MultiButtonHeaderMargin}"/>

                            <TextBox Grid.Row="1"
                                     x:Name="PART_TextBox"
                                     Text="{TemplateBinding Text}"
                                     AcceptsReturn="{TemplateBinding AcceptsReturn}"
                                     TextWrapping="{TemplateBinding TextWrapping}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="30"
                                     Padding="{StaticResource TextBoxPadding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>