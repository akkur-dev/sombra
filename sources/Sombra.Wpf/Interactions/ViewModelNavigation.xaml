<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Sombra.Wpf.Views"
                    xmlns:vm="clr-namespace:Sombra.Wpf.ViewModels">

    <DataTemplate DataType="{x:Type vm:ListPanelViewModel}">
        <v:ListPanelView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EmptyPanelViewModel}">
        <v:EmptyPanelView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditPanelViewModel}">
        <v:EditPanelView/>
    </DataTemplate>

</ResourceDictionary>
